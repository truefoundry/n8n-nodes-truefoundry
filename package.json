{
    "name": "n8n-nodes-truefoundry",
    "version": "0.1.0",
    "description": "n8n community node providing a TrueFoundry AI Gateway chat model for AI Agents — one OpenAI-compatible API to 1000+ LLMs with governance and cost tracking.",
    "license": "MIT",
    "homepage": "https://www.truefoundry.com/docs/ai-gateway/n8n",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "n8n-nodes",
        "truefoundry",
        "ai-gateway",
        "llm-gateway",
        "chat-model",
        "llm",
        "ai",
        "ai-agent",
        "langchain",
        "openai-compatible",
        "llmops",
        "model-routing",
        "llm-observability"
    ],
    "author": {
        "name": "TrueFoundry",
        "email": "abhishek@truefoundry.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/truefoundry/n8n-nodes-truefoundry.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/TruefoundryApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/LmChatTruefoundry/LmChatTruefoundry.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.45.5",
        "@types/node": "^25.0.3",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    },
    "dependencies": {
        "@langchain/openai": "^0.3.17",
        "openai": "^4.104.0"
    }
}
